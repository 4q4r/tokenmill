{
  "enabled": true,
  "logSavings": true,
  "logLevel": "info",
  "showUpdateEvery": 10,
  "minSavingsPercent": 0,
  "minSavingsTokens": 0,
  "freshnessTurns": 20,
  "tracking": {},
  "techniques": {
    "dedup": true,
    "ansiStripping": true,
    "crRendering": true,
    "exactRLE": {
      "enabled": true,
      "minRun": 3
    },
    "blockFactoring": {
      "enabled": true,
      "minBlock": 2,
      "maxBlock": 20
    },
    "pathDict": {
      "enabled": true,
      "maxCodes": 5,
      "minCount": 3
    },
    "substringDict": {
      "enabled": true,
      "minLen": 40,
      "minCount": 4,
      "experimental": true
    },
    "jton": {
      "enabled": true,
      "minRows": 10
    },
    "jsonCompact": true,
    "tableTSV": true,
    "stacktraceDict": true,
    "jcs": true,
    "jsonNumber": true,
    "markdownWhitespace": true,
    "opaqueDict": true,
    "crossCallPack": true,
    "csvCanonical": true,
    "symbolTable": true,
    "diffLogFold": true,
    "unicodeNormalize": true,
    "htmlEntityDecode": true,
    "base64Compact": true,
    "urlDecode": true,
    "hexCompact": true,
    "prefixFold": true,
    "unicodeUnescape": true,
    "uuidCompact": true,
    "smartPunct": true,
    "mojibakeFix": true,
    "idnDecode": true,
    "ipv6Norm": true,
    "csvUnquote": true,
    "sqlMinify": true,
    "isoNorm": true,
    "epochToIso": true,
    "mdLinkRef": true,
    "xmlCdata": true,
    "headerNorm": true,
    "nfkcFold": true,
    "trailingWs": true,
    "blankRun": true,
    "colorCompact": true,
    "xmlMinify": true,
    "rangeFold": true,
    "urlCanonical": true,
    "tsCanonical": true,
    "thousandSep": true,
    "quotedPrintable": true,
    "baseNorm": true,
    "semverNorm": true,
    "uuidRemap": true
  },
  "experimental": {
    "gcfGraph": false,
    "ison": false
  }
}
